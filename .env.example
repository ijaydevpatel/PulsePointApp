# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# ONLY these two belong in a mobile app.
#
# Anything bundled into an APK is extractable - an APK is a zip file, and
# `EXPO_PUBLIC_*` values end up in plain text inside the JS bundle. So server
# secrets (CLERK_SECRET_KEY, MONGODB_URI, JWT_SECRET, GROQ_API_KEY,
# GEMINI_API_KEY) must stay on the backend and are NOT listed here on purpose.
# The app reaches those services only by calling your own API.

# Clerk publishable key. Designed to be public - safe to ship.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Your backend, ORIGIN ONLY — no /api suffix, no trailing slash.
# Service paths already start with /api, so adding it here double-prefixes
# every request and they all 404.
EXPO_PUBLIC_API_URL=https://your-service.onrender.com
