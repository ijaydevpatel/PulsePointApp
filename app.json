{
  "expo": {
    "name": "PulsePoint",
    "slug": "pulsepoint-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "nz.ac.aut.comp826.pulsepoint",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#12263A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PulsePoint uses your location only to show local air quality, UV and humidity. It is never stored or sent to our servers."
        }
      ]
    ],
    "scheme": "pulsepoint"
  }
}